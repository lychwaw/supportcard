# Copy to .env and fill in real values. Never commit .env.

# ─── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side (Vercel functions — no VITE_ prefix)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://your-app.vercel.app

# ─── Anthropic (Claude AI) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Dodo Payments ────────────────────────────────────────────────────────────
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PRODUCT_ID_ESSENTIAL=
DODO_PRODUCT_ID_PLUS=
DODO_PRODUCT_ID_PREMIUM=


# ─── RevenueCat (Apple IAP) ──────────────────────────────────────────────────
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxx
REVENUECAT_WEBHOOK_SECRET=

# ─── KoraPay (SA ID verification only) ───────────────────────────────────────
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=

# ─── Apple APNs (push notifications) ─────────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.southsphere.supportcard
APNS_ENV=production
APNS_PRIVATE_KEY=

# ─── Apple MapKit JS (web map) ────────────────────────────────────────────────
APPLE_TEAM_ID=
APPLE_MAPKIT_KEY_ID=
APPLE_MAPKIT_PRIVATE_KEY=
