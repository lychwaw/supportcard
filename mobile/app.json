{
  "expo": {
    "name": "SupportCard",
    "slug": "supportcard",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "supportcard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.southsphere.supportcard",
      "buildNumber": "1",
      "config": {
        "googleMapsApiKey": ""
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SupportCard uses your location to verify custody handoffs and log check-ins at specific locations.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SupportCard uses your location to log custody check-ins.",
        "NSCameraUsageDescription": "SupportCard uses your camera to upload receipts and documents.",
        "NSPhotoLibraryUsageDescription": "SupportCard accesses your photo library to attach images to expense requests and documents.",
        "NSPhotoLibraryAddUsageDescription": "SupportCard saves exported court records to your photo library.",
        "NSFaceIDUsageDescription": "SupportCard uses Face ID to secure access to your account data.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "co.za.supportcard.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2B74D6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "SupportCard accesses your photos to attach receipts and documents to expense requests.",
          "cameraPermission": "SupportCard uses your camera to scan receipts and upload proof of expenses."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SupportCard uses your location to verify custody handoffs and log check-ins.",
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2B74D6",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EBF4FF"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f766b24c-9764-48ba-bb67-4af604014cc1"
      }
    },
    "owner": "supportcard",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f766b24c-9764-48ba-bb67-4af604014cc1",
      "fallbackToCacheTimeout": 0
    }
  }
}
