# Copy to .env.local and fill in real values
# Prefix EXPO_PUBLIC_ makes variables available in the React Native bundle
# Never put secrets (service role keys) here — client code only

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed Vercel API (for My SCAI, KoraPay, etc.)
EXPO_PUBLIC_API_BASE_URL=https://supportcard.vercel.app
